# Supabase → Project Settings → API (or "Connect")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Either the new publishable key (sb_publishable_…) or the legacy anon key works
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Optional: any long random string. Protects /api/keepalive (Vercel sends it automatically to cron jobs)
CRON_SECRET=
